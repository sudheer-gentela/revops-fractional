# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values; .env is git-ignored.

# Required: the Gmail account that sends the emails, and its App Password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where enquiries are sent. Defaults to GMAIL_USER if left empty.
NOTIFY_EMAIL=

# Name shown on outgoing emails.
FROM_NAME=Sudheer Gentela

# Used in the visitor's confirmation email. Optional.
SITE_URL=
BOOKING_URL=

# Set to false to stop the confirmation email to visitors.
SEND_AUTO_REPLY=true

# Mutual NDA: when true, your signature (name and title from nda-text.json) is
# applied automatically, so the PDF both sides receive is fully executed.
# When false, the signer's copy says you'll countersign, and you do it manually.
NDA_AUTO_COUNTERSIGN=false

# Optional: also log every enquiry to a Google Sheet.
# Share the sheet with the service account email as an Editor, and create a tab
# named as below with columns: Time, Name, Email, Company, Model, Interest, CRM, Topics, Message
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
